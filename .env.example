# Copy to .env and fill in. Never commit .env.

# Signs the login tokens (JWT). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite file, relative to the working directory.
DATABASE_URL=sqlite:///./filmabend.db

# TMDB API key (v3 auth) from https://www.themoviedb.org/settings/api
# Without it the app works, but movie search is disabled.
TMDB_API_KEY=

# Initial admin, created on first start only (when no admin exists yet).
# The password must be at least 12 characters; there is no default.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=

# Only needed if the frontend is served from a different origin.
# JSON list, e.g. ["https://movies.example.com"]
CORS_ORIGINS=[]

# Login/registration attempts per client IP and time window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
